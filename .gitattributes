/LICENSE text eol=lf
# License notices copied into images and the ToukaIDE VSIX keep LF on every checkout.
/NOTICE text eol=lf
/ToukaIDE/THIRD_PARTY_NOTICES.txt text eol=lf
/ToukaProxy/licenses/** text eol=lf
/ToukaProxy/setup.sh text eol=lf

# Container build inputs keep LF on every checkout.
/ToukaProxy/Dockerfile text eol=lf
/ToukaHeartbeat/Dockerfile text eol=lf
/ToukaHeartbeat/permission_init.py -text
/ToukaChat/Dockerfile.prod text eol=lf
/ToukaChat/scripts/ensure-critical-native.mjs text eol=lf
/docker-compose.ghcr.yml text eol=lf
/tests/docker/Dockerfile.isolation-test text eol=lf

# 本機小幫手：GitHub raw 給的是 LF 的 blob，一行指令與 install.ps1 的雜湊照它算（ADR-0329）。
/ToukaLocal/**/*.py text eol=lf
/ToukaLocal/*.ps1 text eol=lf
/ToukaLocal/*.md text eol=lf
