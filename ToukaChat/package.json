{
  "name": "frontend",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": "24.22.1",
    "npm": "11.19.1"
  },
  "packageManager": "npm@11.19.1",
  "devEngines": {
    "runtime": {
      "name": "node",
      "version": "24.22.1",
      "onFail": "error"
    },
    "packageManager": {
      "name": "npm",
      "version": "11.19.1",
      "onFail": "error"
    }
  },
  "scripts": {
    "dev": "npm run sync-api && npm run gen:artifact-runtime && next dev -p 3001",
    "gen:artifact-runtime": "node scripts/build-artifact-runtime.mjs",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "sync-api": "npx openapi-typescript ../openapi.json -o src/types/api.ts",
    "sync:design": "npx tsx scripts/sync-design.ts",
    "guard:api": "npx tsx scripts/guard_frontend.ts",
    "guard:time": "npx tsx scripts/guard_time.ts",
    "guard:design": "npx tsx scripts/guard_design.ts",
    "guard:theme": "npx tsx scripts/guard_theme.ts",
    "guard:hooks": "npx tsx scripts/guard_hooks.ts",
    "guard:integrity": "npx tsx scripts/guard_integrity.ts",
    "guard:css": "npx tsx scripts/guard_css_integrity.ts",
    "guard:errors": "npx tsx scripts/guard_errors.ts",
    "guard:env": "npx tsx scripts/guard_env.ts",
    "guard:fetch": "npx tsx scripts/guard_fetch.ts",
    "guard:localStorage": "npx tsx scripts/guard_localStorage.ts",
    "guard:xagentid": "npx tsx scripts/guard_xAgentId.ts",
    "guard:eventSource": "npx tsx scripts/guard_eventSource.ts",
    "guard:console": "npx tsx scripts/guard_console.ts",
    "guard:orphaned-tests": "npx tsx scripts/guard_orphaned_tests.ts",
    "guard:typecheck": "npx tsc --project tsconfig.guard.json --noEmit",
    "guard:prune": "node --import ./scripts/knip-no-cache.mjs ./node_modules/knip/bin/knip.js --no-gitignore --reporter compact",
    "guard:i18n": "npx tsx scripts/guard_i18n.ts",
    "guard:audit": "npm audit --audit-level=high --omit=dev",
    "gen:design": "npm run sync:design",
    "test": "npm run gen:artifact-runtime && vitest run",
    "test:e2e": "playwright test --project=chromium",
    "install:controlled": "npm ci --ignore-scripts"
  },
  "dependencies": {
    "@astral-sh/ruff-wasm-web": "^0.15.6",
    "@babel/standalone": "^7.29.7",
    "@radix-ui/react-checkbox": "^1.3.3",
    "@radix-ui/react-select": "^2.2.6",
    "@radix-ui/react-slider": "^1.3.6",
    "@radix-ui/react-switch": "^1.2.6",
    "@radix-ui/react-tabs": "^1.1.13",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "dompurify": "3.4.17",
    "framer-motion": "^12.34.4",
    "i18next": "^26.3.1",
    "i18next-browser-languagedetector": "^8.2.1",
    "lucide-react": "^0.576.0",
    "mermaid": "11.16.1",
    "next": "16.4.2",
    "next-themes": "^0.4.6",
    "node-pty": "^1.1.0",
    "radix-ui": "^1.4.3",
    "react": "19.2.3",
    "react-diff-view": "^3.3.2",
    "react-dom": "19.2.3",
    "react-i18next": "^17.0.8",
    "react-markdown": "^10.1.0",
    "react-resizable-panels": "^2.1.7",
    "react-virtuoso": "^4.18.3",
    "remark-gfm": "^4.0.1",
    "serve": "14.2.6",
    "socket.io": "^4.5.4",
    "socket.io-client": "^4.2.0",
    "sonner": "^2.0.7",
    "tailwind-merge": "^3.5.0",
    "xterm-addon-fit": "^0.8.0",
    "zustand": "^5.0.12"
  },
  "devDependencies": {
    "@playwright/test": "^1.62.1",
    "@tailwindcss/postcss": "^4",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.2",
    "@types/babel__standalone": "^7.1.9",
    "@types/node": "^24.13.3",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@vitejs/plugin-react": "^6.0.1",
    "concurrently": "^9.2.1",
    "esbuild": "^0.28.0",
    "eslint": "^9",
    "eslint-config-next": "16.4.2",
    "fast-glob": "^3.3.3",
    "jsdom": "^29.0.1",
    "knip": "^5.88.1",
    "openapi-typescript": "^7.13.0",
    "prettier": "^3.8.3",
    "prettier-plugin-tailwindcss": "^0.8.0",
    "shadcn": "^4.22.0",
    "tailwindcss": "^4",
    "ts-morph": "^28.0.0",
    "tsx": "^4.20.5",
    "tw-animate-css": "^1.4.0",
    "typescript": "^5",
    "vite-tsconfig-paths": "^6.1.1",
    "vitest": "^4.1.12"
  },
  "overrides": {
    "shadcn": {
      "@modelcontextprotocol/sdk": "1.32.1"
    },
    "concurrently": {
      "shell-quote": "1.11.0"
    },
    "serve": {
      "compression": "1.8.2"
    },
    "ws": "^8.21.0",
    "postcss": "^8.5.18",
    "fast-uri": "3.1.9",
    "nanoid": "3.3.18",
    "socket.io-parser": "4.2.7",
    "@hono/node-server": "^2.0.5",
    "@redocly/openapi-core": {
      "js-yaml": "4.3.2"
    },
    "browserslist": "4.29.3",
    "ip-address": "10.7.4",
    "js-yaml": "4.3.2",
    "undici": "7.30.1",
    "hono": "4.13.13",
    "qs": "6.16.0",
    "@humanfs/node": "0.16.8",
    "postcss-selector-parser": "7.1.6",
    "caniuse-lite": "1.0.30001816",
    "node-releases": "2.0.59",
    "electron-to-chromium": "1.5.458",
    "baseline-browser-mapping": "2.11.29",
    "@humanfs/core": "0.19.2",
    "@humanfs/types": "0.15.0",
    "side-channel": "1.1.1",
    "side-channel-list": "1.0.1"
  }
}
