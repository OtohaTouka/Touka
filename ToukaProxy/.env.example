# =========================================================================
# 🌫️ Touka Proxy 核心環境變數配置範本
# =========================================================================
# 請將此檔案複製為 .env 並填入實際值。
# 注意：本系統現在「強制要求」設定 MEMORY_APP_DATA_DIR 以防資料路徑錯誤。

# === [環境配置模式說明] ===
# 1. 整合模式 (推薦): 當此資料夾位於 repo 根目錄內時，系統會自動向上搜尋並讀取
#    根目錄的 .env。此時下列「共用路徑」與「心跳金鑰」已在根目錄定義，由 SSOT 管理。
# 2. 獨立模式: 若將此資料夾單獨移出，請取消下列變數的註釋並手動定義。

# [共用路徑 - 整合時由根目錄 .env 管理]
# MEMORY_APP_DATA_DIR=/path/to/data
# MEMORY_SYSTEM_SRC_DIR=/path/to/ToukaMemory

# [Proxy 專屬路徑]
# 外掛目錄；不設時用 ToukaProxy/src/plugins
# PLUGIN_DIR=


# -------------------------------------------------------------------------
# 2. API 金鑰 (API KEYS)
# -------------------------------------------------------------------------

# Anthropic API Key (Claude 系列模型，Proxy 的核心能力來源)
ANTHROPIC_API_KEY=sk-ant-xxx

# Google Gemini API Key (Gemini 推理模型與 Grounding 搜尋)
GEMINI_API_KEY=AIzaSy...

# xAI Grok API Key (Grok 推理與快速模型)
GROK_API_KEY=xai-...

# Tavily API Key (研究工具的即時資訊獲取)
TAVILY_API_KEY=tvly-...

# [Tavily 搜尋調校 (ADR-0090) — 皆有預設值，可不填]
# 搜尋深度: basic | advanced。advanced 結果較深、更準，但每次耗 2 API credits (basic 為 1)。
# TAVILY_SEARCH_DEPTH=advanced
# 回傳結果數上限 (預設 5)
# TAVILY_MAX_RESULTS=5
# 是否由 Tavily 生成直接答案摘要並置頂 (對標大廠 AI Overview，預設 true)
# TAVILY_INCLUDE_ANSWER=true

# [搜尋備援鏈 (ADR-0091) — research 預設 source=auto：Tavily→SearXNG→DuckDuckGo]
# SearXNG 自架端點 (免金鑰、查詢不外洩)。空字串=停用、auto 鏈跳過此來源。
# 自架方式見根目錄 docker-compose.searxng.yml。例：http://touka-searxng:8080
# SEARXNG_BASE_URL=
# 注意：auto 的最後備援 DuckDuckGo 仍會把查詢送往 api.duckduckgo.com (免金鑰、HTTPS)。
# 要「查詢完全不外洩」請自架 SearXNG 並把 research 固定為 source=searxng。

# OpenAI API Key (GPT-4o 系列模型，可選)
OPENAI_API_KEY=sk-proj-...

# DeepSeek API Key (deepseek-chat / deepseek-reasoner；OpenAI 相容、成本低，可選)
DEEPSEEK_API_KEY=sk-...


# -------------------------------------------------------------------------
# 3. 系統運作設定 (SYSTEM CONFIG)
# -------------------------------------------------------------------------

# 是否啟動「啟動時」動態模型發現 (true/false)。
# 預設 false（安全預設）：開機不主動對外發現，避免不必要的對外請求；存入 provider 金鑰時會
# 即時探測該供應商（免重啟），故日常使用無需開啟。開發時可自行設 true 以開機即全面發現。
ENABLE_DYNAMIC_MODELS=false

# 伺服器綁定主機與埠號 (預設: 0.0.0.0:8000)
# HOST=0.0.0.0
# PORT=8000

# [MCP OAuth（ADR-0206／0207）]
# 預設全部關閉。P8-B 只支援單一 Proxy server process；不得加 uvicorn --workers。
TOUKA_MCP_OAUTH_USER_ENABLED=false
TOUKA_MCP_OAUTH_WORKLOAD_ENABLED=false
TOUKA_MCP_OAUTH_DELEGATION_ENABLED=false
# P8-B 啟用前必須人工確認 config volume 是本機 filesystem，再改為 local。
# remote／unknown 會讓 workload runtime fail-start。
TOUKA_MCP_OAUTH_WORKLOAD_FILESYSTEM_KIND=unknown
TOUKA_MCP_OAUTH_WORKLOAD_KEY_SOURCE=managed
TOUKA_MCP_OAUTH_WORKLOAD_KEY=
TOUKA_MCP_OAUTH_WORKLOAD_RETIRED_KEYS=[]
TOUKA_MCP_OAUTH_WORKLOAD_ROTATION_PHASE=stable
TOUKA_MCP_OAUTH_WORKLOAD_KEY_EPOCH=1


# -------------------------------------------------------------------------
# 4. 測試與調試路徑 (TEST & DEBUG)
# -------------------------------------------------------------------------
# 執行 tests/ 下的腳本時，必須正確填寫以下絕對路徑。

# 指向 proxy_payload.log 的絕對路徑
TEST_PROXY_LOG_PATH=

# 指向 ToukaMemory/data/vault/core_memory.db 的絕對路徑
TEST_DB_PATH_MEMORY=

# 指向 ToukaProxy/data/vault/core_memory.db 的絕對路徑
TEST_DB_PATH_PROXY=


# -------------------------------------------------------------------------
# ⚠️ 注意事項
# -------------------------------------------------------------------------
# 1. 修改 .env 後，若在 Docker 環境下請重啟容器 (docker-compose restart)。
# 2. ⚠️ 重要：手動重啟 Docker 前，請務必手動核對以下檔案是否被 Agent 惡意修改：
#    - ToukaProxy/src/tools/terminal.py (黑名單是否被刪除)
#    - ToukaProxy/src/routers/heartbeat.py (驗證邏輯是否被繞過)
#    - ToukaProxy/.env (是否有不明的外部 URL)
# 3. 請確保 MEMORY_APP_DATA_DIR 目錄具備讀寫權限。
# 4. 請勿將包含實際金鑰的 .env 檔案上傳至任何公開 Git 倉庫。


# -------------------------------------------------------------------------
# 5. 心跳設定 (HEARTBEAT)
# -------------------------------------------------------------------------

# [心跳專用金鑰與網址]
# 建議統一在根目錄 .env 管理，此處僅留作備援
# HEARTBEAT_TOKEN=
# HEARTBEAT_EXTERNAL_URL=http://localhost:8000/v1/heartbeat/awaken
