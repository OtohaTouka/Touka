{
    "hub": [
        {
            "id": "curated-mcp-docgen",
            "name": "mcp-docgen",
            "category": "File",
            "description": "Touka 自家開源 MCP（mcp-docgen）：用 Markdown／表格資料建立、讀取、編輯、互轉 Word／Excel／PowerPoint／PDF／HTML 文件（含 PDF 合併/分割/抽頁）。",
            "command": "uvx",
            "args": [
                "mcp-docgen==0.8.0"
            ],
            "env_requirements": [],
            "env": {
                "MCP_DOCGEN_INPUT_DIR": "@TOUKA_APPDATA@",
                "MCP_DOCGEN_OUTPUT_DIR": "@TOUKA_OUTPUT@"
            },
            "vault_jail_arg": "base_dir",
            "source": "curated",
            "is_official": false,
            "popularity": 999999,
            "icon": "FileText"
        },
        {
            "id": "curated-notion",
            "name": "Notion",
            "category": "File",
            "description": "Notion 官方（Notion Labs）發行的 MCP 伺服器：以 integration token 存取 Notion 頁面、資料庫與留言，支援搜尋、頁面／區塊讀寫與 Markdown 取用（24 個工具）。",
            "command": "npx",
            "args": [
                "-y",
                "@notionhq/notion-mcp-server@2.5.0"
            ],
            "env_requirements": [
                "NOTION_TOKEN"
            ],
            "source": "curated",
            "is_official": false,
            "popularity": 999998,
            "icon": "FileText",
            "npm_package": "@notionhq/notion-mcp-server",
            "source_url": "https://github.com/makenotion/notion-mcp-server"
        },
        {
            "id": "curated-atlassian",
            "name": "Atlassian",
            "category": "Dev",
            "description": "社群維護（非 Atlassian 官方發行）的 Jira／Confluence MCP 伺服器：以 API Token 查詢議題、轉換狀態與讀寫頁面。出廠限 default 工具組＋唯讀模式（16 工具），可於設定頁調整；Confluence 需另補 CONFLUENCE_* 變數。",
            "command": "uvx",
            "args": [
                "mcp-atlassian==0.23.0"
            ],
            "env_requirements": [
                "JIRA_URL",
                "JIRA_USERNAME",
                "JIRA_API_TOKEN"
            ],
            "env": {
                "TOOLSETS": "default",
                "READ_ONLY_MODE": "true"
            },
            "source": "curated",
            "is_official": false,
            "popularity": 999998,
            "icon": "Ticket",
            "source_url": "https://github.com/sooperset/mcp-atlassian"
        },
        {
            "id": "curated-figma",
            "name": "Figma",
            "category": "Utils",
            "description": "社群維護（Framelink／GLips 發行，非 Figma 官方）的 Figma MCP 伺服器：讀取設計稿的版面與樣式資料並下載圖片素材，用於設計轉程式碼（2 個工具）。",
            "command": "npx",
            "args": [
                "-y",
                "figma-developer-mcp@0.13.2",
                "--stdio"
            ],
            "env_requirements": [
                "FIGMA_API_KEY"
            ],
            "env": {
                "IMAGE_DIR": "@TOUKA_OUTPUT@",
                "FRAMELINK_TELEMETRY": "off"
            },
            "source": "curated",
            "is_official": false,
            "popularity": 999998,
            "icon": "Palette",
            "npm_package": "figma-developer-mcp",
            "source_url": "https://github.com/GLips/Figma-Context-MCP"
        },
