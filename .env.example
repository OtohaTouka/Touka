# Touka 系統環境變數範本
# 僅在 .env 不存在時由部署者複製；勿重新命名／覆寫已有設定。參閱 README_QUICKSTART.md。

# 服務埠號設定
PROXY_PORT=8000
HEARTBEAT_PORT=8082
# CHAT_PORT=3001

# ── AI 廠商 API 金鑰（整合模式只讀這份根目錄 .env，禁令 38）────────────────
# 用到哪家填哪家，其餘留空；值請勿填佔位字串，否則會被當成真金鑰送出。
# Anthropic（Claude 系列模型）
ANTHROPIC_API_KEY=
# Google Gemini（Gemini 模型與 Grounding 搜尋）
GEMINI_API_KEY=
# xAI Grok（Grok 模型）
GROK_API_KEY=
# OpenAI（GPT 系列模型）
OPENAI_API_KEY=
# DeepSeek（deepseek-chat / deepseek-reasoner）
DEEPSEEK_API_KEY=
# Tavily（research 工具的網頁搜尋；不填時改用 SearXNG／DuckDuckGo 備援）
TAVILY_API_KEY=

# 數據存儲路徑 (Agent 靈魂與記憶)
# 注意：若為 Windows 路徑，建議使用正斜線 / 或雙反斜線 \\
SANCTUARY_DATA_PATH=./data
# GHCR Compose 指定容器內 MEMORY_APP_DATA_DIR；native 開發才另設自己的資料絕對路徑。

# Memory 已整合於 Proxy；GHCR 使用者不需要記憶系統源碼掛載。

# 向量嵌入模型 (SentenceTransformer；ToukaMemory 語意檢索 SSOT，預設 all-MiniLM-L6-v2)
# EMBEDDING_MODEL=all-MiniLM-L6-v2

# 專案工作區根目錄
# WORKSPACE_ROOT=  # 未設定時採 Compose 預設；需要時填部署者自己的主機路徑。

# Heartbeat 設定與通訊
# ADR-0150：heartbeat 設定改掛『目錄』而非單檔（避開 Docker 對缺席單檔來源自動建成目錄→
# 掛到容器內是檔案的 /app/config.json→型別衝突而啟動崩潰）。以下覆寫「宿主設定目錄」位置；
# 留空／不設＝用 compose 預設（開發版 ./ToukaHeartbeat/config、pull 版 ./heartbeat-config）。
# config.json 由 heartbeat 於該目錄內自癒生成。（舊鍵 HEARTBEAT_CONFIG_PATH 已停用可刪。）
# HEARTBEAT_CONFIG_DIR=./heartbeat-config  # GHCR；開發 compose 預設不同，勿混用。
HEARTBEAT_INTERNAL_URL=http://touka-heartbeat:8082/trigger
# 心跳認證 Token。★留空即可：proxy 首次啟動偵測為空時自動生成並持久化到 .env（禁令 15，
# 比照 DISPATCH_TOKEN/TOUKA_AUTH_SECRET）。先啟動 Proxy 並確認持久化成功，再以新的
# Compose invocation 建立 Heartbeat，才會讀取更新後 env_file；一次 up 的 depends_on 不保證同步。
HEARTBEAT_TOKEN=

# ── Dispatch 設定（ADR-0082：dispatch 隨 proxy 容器內建，由 DispatchSupervisor spawn）──
# 任務派發認證 Token。★留空即可：dispatch 首次 spawn 時自動生成並持久化到 .env（禁令 15，
# 比照 HEARTBEAT_TOKEN）。空值期間 dispatch 拒絕所有請求（secure-by-default）。要固定值再填。
DISPATCH_TOKEN=
# 以下通常不需設定（compose 已內建）：
# DISPATCH_AUTOSPAWN=true     # docker 模式由 compose 設 true；native 模組化模式預設 false（手動跑 server.py）
# DISPATCH_BIND_HOST=0.0.0.0  # 程式碼預設 127.0.0.1；compose 為對外發布 8083 而顯式升開
# DISPATCH_PORT=8083

# ── 執行器 touka-executor 的資源上限（iso-c2）──────────────────────────────
# 全部代理人的指令共用這份上限；下面是 compose 的預設值，要改就取消註解，再 docker compose up -d 才生效。
# TOUKA_EXECUTOR_MEM_LIMIT=2g
# TOUKA_EXECUTOR_PIDS_LIMIT=512
# TOUKA_EXECUTOR_CPUS=2
# 主機（或 Docker 分到的）CPU 少於 2 顆時，上面這行要取消註解並調低（例如 1），否則執行器可能建不起來【推測：沒實測】。

# 安全驗證設定
# JWT 簽章金鑰。★留空即可：首次需要時自動生成並持久化到 .env（禁令 15，比照 HEARTBEAT_TOKEN），
# 重啟後 Token 仍有效、免精靈。要用固定值（多實例共用同金鑰）再填。請勿公開。
TOUKA_AUTH_SECRET=

# ── MCP P8-A 互動式 OAuth（預設關閉）──────────────────────────────────────
# 啟用前必須先建立 config/mcp_oauth_profiles.json 並設定公開 HTTPS callback origin。
# query mode 必須另通過 ingress canary，否則開機拒絕。
TOUKA_MCP_OAUTH_USER_ENABLED=false
TOUKA_MCP_OAUTH_CALLBACK_BASE_URL=
TOUKA_MCP_OAUTH_CALLBACK_RESPONSE_MODE=form_post
TOUKA_MCP_OAUTH_QUERY_CALLBACK_CANARY_VERIFIED=false
# managed：首次啟動可由既有 bootstrap/atomic .env writer 產生；external：必須由部署端注入。
TOUKA_MCP_OAUTH_KEY_SOURCE=managed
TOUKA_MCP_OAUTH_KEY=
TOUKA_MCP_OAUTH_RETIRED_KEYS=[]
TOUKA_MCP_OAUTH_ROTATION_PHASE=stable
TOUKA_MCP_OAUTH_KEY_EPOCH=1
# ── MCP P8-B workload OAuth（ADR-0207；預設關閉）──────────────────────────
# 只支援單一 Proxy server process。現行本機 profile 啟動前必須確認 config volume
# 為本機 filesystem，再明示 local；不能因 ENABLED=false 推定略過此啟動前提。
# 保留 unknown 預設以 fail-closed；不得未確認就設 local。第二 process／多 worker 亦不支援。
TOUKA_MCP_OAUTH_WORKLOAD_ENABLED=false
TOUKA_MCP_OAUTH_DELEGATION_ENABLED=false
TOUKA_MCP_OAUTH_WORKLOAD_FILESYSTEM_KIND=unknown
TOUKA_MCP_OAUTH_WORKLOAD_KEY_SOURCE=managed
TOUKA_MCP_OAUTH_WORKLOAD_KEY=
TOUKA_MCP_OAUTH_WORKLOAD_RETIRED_KEYS=[]
TOUKA_MCP_OAUTH_WORKLOAD_ROTATION_PHASE=stable
TOUKA_MCP_OAUTH_WORKLOAD_KEY_EPOCH=1
# 可選 deterministic limits；未設定時使用 src.config 的 P8-A 安全預設。
# OAUTH_STATE_TTL_SECONDS=600
# OAUTH_ACCESS_REFRESH_LEEWAY_SECONDS=60
# OAUTH_REFRESH_LEASE_SECONDS=30
# OAUTH_DCR_LEASE_SECONDS=30
# OAUTH_POPUP_POLL_INTERVAL_MS=1000
# OAUTH_POPUP_TIMEOUT_MS=120000
# OAUTH_CLEANUP_INTERVAL_SECONDS=300
# OAUTH_WORKER_LIVENESS_SECONDS=900
# OAUTH_MAX_CLOCK_ROLLBACK_SECONDS=5

# Cookie 安全設定（開發環境 HTTP 需設為 false）
SECURE_COOKIES=false

# ── 歷史雲端設定參考（NOT_SELECTED，非現行本機安裝流程）────────────────────
# 啟用雲端模式：停用 LDH 自動發卡，改用 X-Real-IP 做客戶端識別
# 部署到公網 VPS 時必須設為 true，搭配 nginx 反向代理使用
# CLOUD_MODE=true

# 允許跨域存取的前端來源（逗號分隔）
# 範例：ALLOWED_ORIGINS=https://chat.yourdomain.com,https://www.yourdomain.com
# ALLOWED_ORIGINS=

# 前端（瀏覽器）可存取的 Proxy API 位址（雲端部署時填入你的域名）
# NEXT_PUBLIC_PROXY_URL=https://api.yourdomain.com

# 前端（瀏覽器）可存取的 Heartbeat 位址（雲端部署時填入你的域名）
# NEXT_PUBLIC_HEARTBEAT_URL=https://heartbeat.yourdomain.com

# ── 自架 SearXNG 隱私搜尋（選用，ADR-0091 / Web Search Phase C）──────────────
# research 工具 auto 備援鏈的「免金鑰、查詢不外洩」來源。啟用步驟：
#   1. 設定下方兩個變數（SEARXNG_SECRET 改成隨機字串）
#   2. docker compose -f docker-compose.yml -f docker-compose.searxng.yml up -d
# SEARXNG_BASE_URL：proxy 連往 SearXNG 的位址（同網路用容器名）。空＝停用。
# SEARXNG_BASE_URL=http://touka-searxng:8080
# SEARXNG_SECRET：SearXNG 必要密鑰。Generate: python -c "import secrets; print(secrets.token_hex(32))"
# SEARXNG_SECRET=<your-random-secret>
