# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# Storybook build output (removed from project but kept here to prevent accidental re-commits)
/storybook-static/

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem
.vscode/

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*
!.env.local.example

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# Generated artifact runtime bundle (ADR-0114); explicit dev/build/CI generation.
src/generated/
