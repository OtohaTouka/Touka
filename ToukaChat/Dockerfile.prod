# ToukaChat 生產建置 Dockerfile（多階段）
# 與 Dockerfile（開發用）分離，供 GHCR 發布使用。
#
# 建置流程：
#   1. builder stage：安裝依賴 → npm run build → 輸出靜態檔案到 out/
#   2. runner stage：以 serve 服務 out/ 目錄（無 Next.js server 需求）
#
# Node／npm 取自官方 node 映像（v24.22.1，digest 釘版）；Debian 套件以 apt-get upgrade 取官方安全更新。
# 注意：這個映像不含終端伺服器（ToukaChat 的開發終端伺服器已於 ADR-0294 移除）。

FROM node@sha256:43b9ba1142b8dcf33fa8f922ca1be85714adc444e0586c7cf7726daaeabc1bea AS node-runtime

# repo 根的 LICENSE／NOTICE：build context 只有 ToukaChat/，由具名 context touka-root 提供
#（compose 的 additional_contexts、GHCR 發布的 build-contexts）。具名 context 會取代這個同名的空階段；
# 沒帶它時下面的 COPY 找不到檔案而建置失敗，不會改去 registry 拉一個叫 touka-root 的映像。
FROM scratch AS touka-root

# ── Stage 1: Builder ──────────────────────────────────────────────────────────
# builder 以 Python 基底提供 node-gyp 需要的 python3、make、g++。
FROM python:3.12-slim-trixie@sha256:78387bc3881b8273120a12ebe6c1ab22b018ccc2c9adf565ae1ac9b536e184ea AS builder
RUN apt-get update && apt-get install -y --no-install-recommends \
    bash ca-certificates libstdc++6 make g++ && rm -rf /var/lib/apt/lists/*
COPY --from=node-runtime /usr/local/bin/node /usr/local/bin/node
COPY --from=node-runtime /usr/local/lib/node_modules/npm /usr/local/lib/node_modules/npm
RUN ln -s ../lib/node_modules/npm/bin/npm-cli.js /usr/local/bin/npm && \
    ln -s ../lib/node_modules/npm/bin/npx-cli.js /usr/local/bin/npx && \
    test "$(node --version)" = 'v24.22.1'
# package.json 以 engine-strict 鎖定 npm 11.19.1；映像自帶版本不保證相同，明確安裝。
RUN npm install -g --ignore-scripts --no-audit --no-fund npm@11.19.1 && test "$(npm --version)" = '11.19.1'

WORKDIR /app

# 安裝完整建置依賴，但拒絕 package lifecycle scripts。
COPY package*.json .npmrc ./
COPY scripts/ensure-critical-native.mjs scripts/ensure-critical-native.mjs
RUN npm ci --ignore-scripts --no-audit --no-fund --cache=.npm-cache
RUN node scripts/ensure-critical-native.mjs --npm /usr/local/bin/npm --cache .npm-cache

# 複製原始碼
# src/types/api.ts 已在 git 追蹤中（由 sync-api 生成並 commit），
# 無需在此執行 sync-api；直接 npm run build 即可。
COPY . .

# ⚠️ 靜態匯出（output: "export"）的 NEXT_PUBLIC_* 於「build 時」內嵌進 bundle——
# compose 的 runtime environment 對靜態檔完全無效。必須以 build ARG 注入：
# 本機 compose 預設 http://localhost:8000；雲端（nginx 反代/自訂網域）於 .env 設
# NEXT_PUBLIC_PROXY_URL 覆寫。缺了它 PROXY_URL 內嵌為空字串 → 登入打到相對路徑
# /v1/auth/login → serve -s 回 index.html → 前端報「Unexpected token '<'」。
ARG NEXT_PUBLIC_PROXY_URL=http://localhost:8000
ARG NEXT_PUBLIC_HEARTBEAT_URL=http://localhost:8082
ENV NEXT_PUBLIC_PROXY_URL=$NEXT_PUBLIC_PROXY_URL \
    NEXT_PUBLIC_HEARTBEAT_URL=$NEXT_PUBLIC_HEARTBEAT_URL
ENV NEXT_TELEMETRY_DISABLED=1

# repo-owned generator 與 build 明示分離；不得依賴 prebuild/postinstall lifecycle。
RUN npm run gen:artifact-runtime --ignore-scripts
RUN npm run build --ignore-scripts
COPY --from=touka-root LICENSE NOTICE /touka-licenses/

# ── Stage 2: Runner ───────────────────────────────────────────────────────────
FROM node-runtime AS runner
RUN apt-get update && apt-get upgrade -y && rm -rf /var/lib/apt/lists/*
RUN npm install -g --ignore-scripts --no-audit --no-fund npm@11.19.1 && test "$(npm --version)" = '11.19.1'

WORKDIR /app

# Runtime 只用 lockfile 內精確依賴；lifecycle 永遠停用，不安裝 global latest。
COPY package*.json .npmrc ./
# --omit=optional：serve 只送靜態檔，不需要 next 的選用依賴（sharp 會帶進 LGPL 的 libvips）。
RUN npm ci --omit=dev --ignore-scripts --no-audit --no-fund --omit=optional

# 從 builder 複製靜態輸出與授權檔（授權檔隨映像散布）
COPY --from=builder /app/out ./out
COPY --from=builder /touka-licenses/ ./

# P8 fix: 以非 root 使用者執行（依賴與靜態資產維持 root-owned read-only）。
RUN groupadd -g 1001 appuser && useradd -r -u 1001 -g 1001 -m appuser

ARG TOUKA_SOURCE_REVISION
LABEL org.opencontainers.image.title="touka-chat" \
    org.opencontainers.image.revision="${TOUKA_SOURCE_REVISION}" \
    org.opencontainers.image.source="https://github.com/OtohaTouka/Touka"

ENV NO_UPDATE_CHECK=1

USER appuser

# Next.js dev 跑在 3001；生產 serve 也使用相同埠號確保一致性
EXPOSE 3001

# 服務靜態檔案（-s 為 SPA 模式，所有路由回傳 index.html）
CMD ["./node_modules/.bin/serve", "-s", "out", "-l", "3001"]
