        {
            "id": "curated-github",
            "name": "GitHub",
            "category": "Dev",
            "description": "GitHub 官方發行的遠端 MCP 伺服器：讀取儲存庫、議題、PR、Actions 與程式碼搜尋。出廠採唯讀端點（/readonly），需自備 Personal Access Token；建議用 fine-grained token 並只授權必要的儲存庫。",
            "url": "https://api.githubcopilot.com/mcp/readonly",
            "headers": {
                "Authorization": "Bearer ${GITHUB_PERSONAL_ACCESS_TOKEN}"
            },
            "env_requirements": [
                "GITHUB_PERSONAL_ACCESS_TOKEN"
            ],
            "source": "curated",
            "is_official": false,
            "popularity": 999997,
            "icon": "Github",
            "source_url": "https://github.com/github/github-mcp-server"
        },
        {
            "id": "curated-zapier",
            "name": "Zapier",
            "category": "Utils",
            "description": "Zapier 官方發行的遠端 MCP 伺服器：以 9,000+ 應用程式為工具面，透過 meta-tool 動態探索並執行動作。需自備 Zapier 帳號並於 mcp.zapier.com 建立伺服器（客戶端選 Other）後產生連線權杖；每次成功工具呼叫會消耗 Zapier task 額度。",
            "url": "https://mcp.zapier.com/api/v1/connect",
            "headers": {
                "Authorization": "Bearer ${ZAPIER_MCP_TOKEN}"
            },
            "env_requirements": [
                "ZAPIER_MCP_TOKEN"
            ],
            "source": "curated",
            "is_official": false,
            "popularity": 999997,
            "icon": "Globe",
            "source_url": "https://docs.zapier.com/mcp/authentication"
        },
        {
            "id": "curated-stripe",
            "name": "Stripe",
            "category": "Utils",
            "description": "Stripe 官方發行的遠端 MCP 伺服器：查詢與操作金流資料（客戶、付款、發票、訂閱、退款）並可搜尋 Stripe 文件。⚠️ 本服務含通用寫入工具，金鑰權限是唯一的安全邊界、Touka 無法代為限制——請務必使用受限金鑰（rk_）且只勾選唯讀權限，建議先用測試模式金鑰（rk_test_）試用。",
            "url": "https://mcp.stripe.com",
            "headers": {
                "Authorization": "Bearer ${STRIPE_RESTRICTED_KEY}"
            },
            "env_requirements": [
                "STRIPE_RESTRICTED_KEY"
            ],
            "source": "curated",
            "is_official": false,
            "popularity": 999997,
            "icon": "CreditCard",
            "source_url": "https://docs.stripe.com/mcp"
        },
