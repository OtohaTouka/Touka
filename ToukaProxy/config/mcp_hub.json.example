        {
            "id": "curated-sentry",
            "name": "Sentry",
            "category": "Dev",
            "description": "Sentry 官方（Functional Software）發行的 MCP 伺服器：查詢組織與專案、搜尋 issue 與事件、更新 issue 狀態，並可調用 Seer 做 AI 根因分析（9 個工具）。授權為 FSL-1.1，非 OSI 開源。",
            "command": "npx",
            "args": [
                "-y",
                "@sentry/mcp-server@0.37.0"
            ],
            "env_requirements": [
                "SENTRY_ACCESS_TOKEN"
            ],
            "source": "curated",
            "is_official": false,
